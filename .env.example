# Nemocnica Snina — environment reference
# Copy to .env.local (dev) or inject via secret manager (staging/prod).
# 🔴 secret (vault only) · 🟢 public/config · ⚙️ per-env
# EU region mandatory for all hosted services (Decree 179/2020).
# In production: OIDC_MOCK_ENABLED=false, HIS_MOCK_ENABLED=false,
#   MFA_REQUIRED=true, rediss:// / amqps:// TLS URLs, no CHANGEME values.

# ── Core ────────────────────────────────────────────────────
NODE_ENV=development                                      # 🟢
APP_BASE_URL=http://localhost:3000                        # 🟢  prod: https://www.nemocnicasnina.sk
API_BASE_URL=http://localhost:4000                        # 🟢
DEFAULT_LOCALE=sk                                         # 🟢
SUPPORTED_LOCALES=sk,cs,pl,hu,uk,en                       # 🟢
TZ=Europe/Bratislava                                      # 🟢
PORT=4000                                                 # 🟢

# ── Database ────────────────────────────────────────────────
# APPLICATION role (ns_app) — INSERT+SELECT only on audit_log (see RETENTION.md)
DATABASE_URL=postgresql://ns_app:CHANGEME@localhost:5432/nemocnica        # 🔴
# SUPERUSER role — migrations only (db:push / db:migrate)
DATABASE_MIGRATION_URL=postgresql://nsadmin:CHANGEME@localhost:5432/nemocnica  # 🔴
REDIS_URL=redis://localhost:6379                          # 🔴  prod: rediss:// (TLS)

# ── Auth: staff (admin / clinician / editor) ────────────────
JWT_SECRET=CHANGEME_min_32_random_chars                   # 🔴
JWT_ACCESS_TTL=900                                        # 🟢  seconds (15 min)
JWT_REFRESH_TTL=2592000                                   # 🟢  seconds (30 days)
TOTP_ISSUER=Nemocnica Snina Admin                         # 🟢  shown in authenticator apps
MFA_REQUIRED=true                                         # 🟢  MUST stay true (Decree 179/2020)
ALLOWED_ORIGINS=http://localhost:3000                     # 🟢  prod: https://www.nemocnicasnina.sk

# ── Auth: patient (eID / OIDC — Slovensko.sk) ──────────────
OIDC_ISSUER_URL=https://oidc.slovensko.sk                 # 🟢  use sandbox issuer in dev/CI
OIDC_CLIENT_ID=CHANGEME                                   # 🔴  registered with ÚPVS
OIDC_CLIENT_SECRET=CHANGEME                               # 🔴
OIDC_REDIRECT_URI=http://localhost:3000/sk/portal/callback # 🟢  must be allowlisted
OIDC_SCOPES=openid profile                                # 🟢
OIDC_USE_PKCE=true                                        # 🟢
# Mock IdP for local dev + CI — MUST be false in production
OIDC_MOCK_ENABLED=true                                    # 🟢  dev/CI only
OIDC_MOCK_PORT=4010                                       # 🟢

# ── Strapi CMS ──────────────────────────────────────────────
STRAPI_URL=http://localhost:1337                          # 🟢
STRAPI_API_TOKEN=CHANGEME                                 # 🔴  read-only API token
STRAPI_WEBHOOK_SECRET=CHANGEME                            # 🔴  ISR revalidation webhook
CONTENT_REVALIDATE_SECONDS=60                             # 🟢

# ── HIS (RabbitMQ + FHIR) ───────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672            # 🔴  prod: amqps:// (TLS)
HIS_FHIR_BASE_URL=https://his-sandbox.local/fhir          # 🟢  hospital-provided
HIS_FHIR_CLIENT_ID=CHANGEME                               # 🔴
HIS_FHIR_CLIENT_SECRET=CHANGEME                           # 🔴
HIS_HL7V2_FALLBACK_ENABLED=true                           # 🟢
# HIS sandbox/mock for local + CI — MUST be false in production
HIS_MOCK_ENABLED=true                                     # 🟢  dev/CI only

# ── NCZI / e-VÚC ────────────────────────────────────────────
HOSPITAL_ICO=52379571                                     # 🟢  IČO used in eDohoda XML
NCZI_EDOHODY_ENDPOINT=https://nczi.example/edohody        # 🟢  hospital-provided
NCZI_API_KEY=CHANGEME                                     # 🔴
NCZI_DOCTOR_CODE_DEFAULT=CHANGEME                         # 🟢
APS_FEED_URL=https://psk.example/aps                      # 🟢  e-VÚC Prešov region
APS_FEED_API_KEY=CHANGEME                                 # 🔴
APS_CACHE_TTL_SECONDS=600                                 # 🟢  10 min

# ── SMS ─────────────────────────────────────────────────────
SMS_PROVIDER=console                                      # 🟢  dev: console | prod: <vendor>
SMS_API_KEY=CHANGEME                                      # 🔴
SMS_SENDER_ID=NemSnina                                    # 🟢  registered sender ID
OTP_TTL_SECONDS=600                                       # 🟢  10 min
OTP_MAX_ATTEMPTS=5                                        # 🟢
BOOKING_REMINDER_HOURS=48                                 # 🟢

# ── Payments ─────────────────────────────────────────────────
PAYMENT_PROVIDER=CHANGEME                                 # 🟢  e.g. gpwebpay | stripe-eu
PAYMENT_PUBLIC_KEY=CHANGEME                               # 🟢  publishable/hosted-fields key
PAYMENT_SECRET_KEY=CHANGEME                               # 🔴
PAYMENT_WEBHOOK_SECRET=CHANGEME                           # 🔴
LSPP_FEE_EUR=1.99                                         # 🟢  General Surgery emergency fee

# ── Translation ──────────────────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-translate.json  # 🔴  mounted at runtime
GCP_PROJECT_ID=CHANGEME                                   # 🟢
TRANSLATION_GLOSSARY_ID=nemocnica-snina-glossary          # 🟢
TRANSLATION_CACHE_TTL_SECONDS=604800                      # 🟢  7 days

# ── Observability ────────────────────────────────────────────
SENTRY_DSN=                                               # 🔴  optional; scrub PII
LOG_LEVEL=info                                            # 🟢

# ── Wearables & Remote Monitoring (Sprint W1) ───────────────
WEARABLES_ENABLED=false                                   # 🟢  true only after W6 compliance gate
WEARABLES_PROVIDER=mock                                   # 🟢  mock | live (live rejected unless ENABLED=true)
WEARABLES_TOKEN_KEY=                                      # 🔴  32-byte hex — generate: openssl rand -hex 32
WEARABLES_OAUTH_REDIRECT_BASE=http://localhost:4000       # 🟢  base for /api/wearables/callback/:platform
WEARABLES_GDPR_RETENTION_DAYS=90                          # 🟢
WEARABLES_PHYSICIAN_ACCESS_WINDOW_DAYS=90                 # 🟢
# Per-platform credentials added in W2 + W3 (leave blank until that sprint):
# LIBRE_CLIENT_ID= … DEXCOM_CLIENT_ID= … WITHINGS_CLIENT_ID= … FITBIT_CLIENT_ID= … (see SPRINT_BACKLOG_WEARABLES.md)

# ── Next.js public vars (prefix NEXT_PUBLIC_) ───────────────
NEXT_PUBLIC_API_URL=http://localhost:4000                 # 🟢
NEXT_PUBLIC_CMS_URL=http://localhost:1337                 # 🟢
