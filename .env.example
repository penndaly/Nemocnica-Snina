# Copy to .env and fill in real values. Never commit .env to git.

# PostgreSQL
DATABASE_URL=postgresql://nsadmin:changeme@localhost:5432/nemocnica_snina
POSTGRES_PASSWORD=changeme

# Redis
REDIS_URL=redis://:changeme@localhost:6379
REDIS_PASSWORD=changeme

# RabbitMQ
RABBITMQ_URL=amqp://nsqueue:changeme@localhost:5672
RABBITMQ_PASSWORD=changeme

# NestJS API
JWT_SECRET=replace_with_64_char_random_string
ALLOWED_ORIGINS=http://localhost:3000,https://nemocnicasnina.sk
PORT=4000

# Strapi CMS (generate with: openssl rand -base64 32)
STRAPI_APP_KEYS=key1,key2,key3,key4
STRAPI_API_TOKEN_SALT=replace_me
STRAPI_ADMIN_JWT=replace_me
STRAPI_JWT=replace_me

# SMS gateway (e.g. InfoSMS, Twilio, SMSGlobal)
SMS_API_KEY=
SMS_SENDER_ID=NemocnicaSN

# e-VÚC / PSK APS live feed (Prešov region ambulatory emergency service)
PSK_APS_API_URL=

# Google Cloud Translation (Phase 9 multilingual)
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Sentry error tracking
SENTRY_DSN=

# Next.js public
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CMS_URL=http://localhost:1337
