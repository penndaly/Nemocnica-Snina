# EU staging / demo environment — copy to infra/.env.staging on the host.
# NEVER commit the filled-in file. This environment is mock-mode only and must
# never hold real patient data (see docs/STAGING_DEPLOYMENT.md).

# Container registry holding the three images (e.g. ghcr.io/penndaly)
REGISTRY=ghcr.io/penndaly
IMAGE_TAG=latest

# Public URL of the staging site — used for CORS + OIDC redirect
APP_BASE_URL=https://staging.nemocnicasnina.sk

# Infra credentials — generate with: openssl rand -base64 32
POSTGRES_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_PASSWORD=

# App secrets — each must be exactly 64 hex chars (32 bytes).
#   openssl rand -hex 32
JWT_SECRET=
STAFF_JWT_SECRET=
WEARABLES_TOKEN_KEY=
STAFF_TOTP_KEY=
RC_ENCRYPTION_KEY=

# Strapi — APP_KEYS is a comma-separated list of 4 random values
STRAPI_APP_KEYS=
STRAPI_API_TOKEN_SALT=
STRAPI_ADMIN_JWT=
STRAPI_TRANSFER_TOKEN_SALT=
STRAPI_JWT=
STRAPI_API_TOKEN=

# Host directory holding fullchain.pem + privkey.pem for nginx
TLS_CERT_DIR=/etc/letsencrypt/live/staging.nemocnicasnina.sk
