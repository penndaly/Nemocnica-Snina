# Strapi 4 CMS.
#
#   docker build -f infra/docker/Dockerfile.cms -t nemocnica-strapi .
#
# Strapi's admin bundle is built at image-build time; the runtime needs the
# full dependency set (plugins are resolved dynamically), so this is a single
# install rather than a pruned production tree.
#
# npm, NOT pnpm — deliberately (CLAUDE.md "one deliberate exemption",
# docs/03-AUDIT.md CI-1). Strapi 4 packages depend on undeclared internal
# deps (@strapi/database → @strapi/utils …) that pnpm's strict layout cannot
# resolve; the CMS does not boot under pnpm. This Dockerfile installs exactly
# as CI's cms-verify job does: `npm ci --workspaces=false` from
# apps/cms/package-lock.json. Only apps/cms is copied — the CMS has no
# workspace dependencies. Node 20: better-sqlite3 9.4.3 has no Node 22
# prebuild and node-gyp falls over (same reason as CI).

FROM node:20-alpine AS base
# Strapi's sharp/better-sqlite3 native deps need a toolchain to build.
RUN apk add --no-cache python3 make g++ vips-dev
WORKDIR /app

FROM base AS build
COPY apps/cms/package.json apps/cms/package-lock.json ./
RUN npm ci --workspaces=false --no-audit --no-fund
COPY apps/cms/ ./
ENV NODE_ENV=production
RUN npm run build

FROM base AS runtime
ENV NODE_ENV=production
COPY --from=build /app /app
# Strapi refuses to boot without public/ (and writes uploads into it), and it
# creates database/migrations at startup — both need to be writable by the
# non-root runtime user, so the whole app directory is handed to `node`.
RUN mkdir -p /app/public/uploads /app/database/migrations \
 && chown -R node:node /app
USER node
EXPOSE 1337
CMD ["npm", "start"]
