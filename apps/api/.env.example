# ── Core ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
DEFAULT_LOCALE=sk
TZ=Europe/Bratislava
PORT=4000

# ── Database ───────────────────────────────────────────────────────────────────
# DATABASE_URL      — app runtime role (ns_app): restricted on audit_log
# DATABASE_MIGRATION_URL — migrator role (nsadmin): used by prisma migrate deploy
DATABASE_URL=postgresql://ns_app:CHANGEME@localhost:5432/nemocnica_snina
DATABASE_MIGRATION_URL=postgresql://nsadmin:CHANGEME@localhost:5432/nemocnica_snina
REDIS_URL=redis://:CHANGEME@localhost:6379

# ── Auth: staff ────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGEME_64_char_hex_minimum
JWT_ACCESS_TTL=900
MFA_REQUIRED=true

# ── Auth: patient (eID / OIDC) ─────────────────────────────────────────────────
OIDC_ISSUER_URL=https://oidc.slovensko.sk
OIDC_CLIENT_ID=CHANGEME
OIDC_CLIENT_SECRET=CHANGEME
OIDC_REDIRECT_URI=http://localhost:3000/sk/portal/callback
OIDC_SCOPES=openid profile
OIDC_USE_PKCE=true
OIDC_MOCK_ENABLED=true   # false in production

# ── Strapi CMS ─────────────────────────────────────────────────────────────────
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=CHANGEME
CONTENT_REVALIDATE_SECONDS=60

# ── HIS / FHIR ─────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://nsqueue:CHANGEME@localhost:5672
HIS_FHIR_BASE_URL=https://his-sandbox.local/fhir
HIS_MOCK_ENABLED=true   # false in production

# ── SMS ────────────────────────────────────────────────────────────────────────
SMS_PROVIDER=console
SMS_SENDER_ID=NemSnina
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
BOOKING_REMINDER_HOURS=48

# ── APS ────────────────────────────────────────────────────────────────────────
PSK_APS_API_URL=https://api.psk.sk/aps
APS_CACHE_TTL_SECONDS=600

# ── Payments ───────────────────────────────────────────────────────────────────
LSPP_FEE_EUR=1.99

# ── Observability ──────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Telehealth / Video ─────────────────────────────────────────────────────────

# Provider identifier — 'livekit' in production; 'mock' in dev/CI
TELEHEALTH_PROVIDER=mock

# LiveKit (or equivalent) — only required when TELEHEALTH_PROVIDER=livekit
LIVEKIT_URL=wss://livekit.example.eu      # must be wss:// in production
LIVEKIT_API_KEY=CHANGEME                  # 🔴 secret
LIVEKIT_API_SECRET=CHANGEME               # 🔴 secret

# TURN server region — restricts ICE candidates to EU-resident TURN relays (GDPR Art. 46)
# For livekit.io cloud: set to the EU region identifier (e.g. 'eu')
# For self-hosted: set to 'self' and confirm the TURN server is EU-resident
# Config validator rejects empty or non-EU region values in production
LIVEKIT_TURN_REGION=eu

# How long a join token is valid (seconds). Default: 3600 (1 hour).
TELEHEALTH_SESSION_TTL_SECONDS=3600
# Token is issued this many seconds before scheduled_at
TELEHEALTH_JOIN_WINDOW_SECONDS=600

# No-show grace period: mark no_show if patient hasn't joined N minutes after scheduled_at
TELEHEALTH_NO_SHOW_GRACE_MINUTES=15

# Recording — MUST be false in production unless DPO has explicitly approved.
# If set to true, TELEHEALTH_RECORDING_DPO_APPROVED must also be true or config validator fails.
TELEHEALTH_RECORDING_ENABLED=false
TELEHEALTH_RECORDING_DPO_APPROVED=false

# PDF summary retention (seconds). After this period, pdf_path files are purged.
# Only applies after his_synced=true. Never purge rows where his_synced=false.
TELEHEALTH_PDF_RETENTION_SECONDS=604800

# PDF generation service (Gotenberg or equivalent, self-hosted EU)
PDF_SERVICE_URL=http://localhost:3030
PDF_SERVICE_API_KEY=CHANGEME              # 🔴 secret

# RabbitMQ event routing keys (can override defaults)
TELEHEALTH_SESSION_ENDED_ROUTING_KEY=telehealth.session.ended
TELEHEALTH_BOOKING_CONFIRMED_ROUTING_KEY=telehealth.booking.confirmed
