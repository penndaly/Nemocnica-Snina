// Nemocnica Snina — Prisma schema
// PostgreSQL operational database (appointments, users, audit)
// CMS content lives in Strapi; this schema owns operational/transactional data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Booking ─────────────────────────────────────────────

model AvailabilitySlot {
  id        String   @id @default(uuid())
  clinicId  String
  date      String   // ISO date YYYY-MM-DD
  time      String   // HH:MM
  booked    Boolean  @default(false)
  bookingId String?  @unique
  booking   Booking? @relation(fields: [bookingId], references: [id])
  createdAt DateTime @default(now())

  @@index([clinicId, date])
  @@map("availability_slots")
}

model Booking {
  id               String         @id @default(uuid())
  clinicId         String
  patientName      String
  patientPhone     String
  patientRcHash    String         // bcrypt hash — never store plaintext RC
  date             String
  time             String
  hasReferral      Boolean        @default(false)
  gdprConsent      Boolean        @default(false)
  referralConsent  Boolean        @default(false)
  mode             String?        // 'telehealth' | null
  status           BookingStatus  @default(PENDING)
  cancelToken      String         @unique
  smsVerified      Boolean        @default(false)
  reminderSent     Boolean        @default(false)
  slot             AvailabilitySlot?
  consents         BookingConsent[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([clinicId, date])
  @@index([cancelToken])
  @@map("bookings")
}

model BookingConsent {
  id          String   @id @default(uuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id])
  consentType String   // 'gdpr' | 'referral' | 'telehealth_medical_record' | 'minor_guardian'
  granted     Boolean
  grantedAt   DateTime @default(now())

  @@index([bookingId])
  @@map("booking_consents")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

// ─── New-patient onboarding ───────────────────────────────

model OnboardingApplication {
  id              String              @id @default(uuid())
  physicianId     String
  patientName     String
  patientRcHash   String              // bcrypt hash
  insurerCode     String
  phone           String
  email           String?
  status          OnboardingStatus    @default(SUBMITTED)
  reviewedById    String?
  reviewNote      String?
  ncziXmlPayload  String?             // generated eDohoda XML on acceptance
  signToken       String?             @unique // token for patient eID signing link
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([physicianId, status])
  @@map("onboarding_applications")
}

enum OnboardingStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
}

// ─── Staff users ──────────────────────────────────────────

model StaffUser {
  id            String     @id @default(uuid())
  email         String     @unique
  name          String
  passwordHash  String
  role          StaffRole  @default(EDITOR)
  mfaEnabled    Boolean    @default(true)
  mfaSecret     String?
  active        Boolean    @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  auditLogs     AuditLog[]

  @@map("staff_users")
}

enum StaffRole {
  EDITOR
  CLINICIAN
  ADMIN
}

// ─── Immutable audit log ──────────────────────────────────

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String?
  actor       StaffUser? @relation(fields: [actorId], references: [id])
  actorEmail  String
  actorRole   String
  action      String
  resource    String
  resourceId  String
  detail      Json?
  ip          String?
  createdAt   DateTime @default(now())

  // Append-only: no update/delete — enforced at application layer + DB policy
  @@index([resource, resourceId])
  @@index([actorEmail])
  @@index([createdAt])
  @@map("audit_log")
}

// ─── SMS OTP ──────────────────────────────────────────────

model SmsOtp {
  id        String   @id @default(uuid())
  phone     String
  codeHash  String
  purpose   String   // "booking" | "login"
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone, purpose])
  @@map("sms_otps")
}

// ─── Telehealth ───────────────────────────────────────────────────────────────

enum TelehealthStatus {
  scheduled
  waiting
  active
  ended
  cancelled
  no_show

  @@map("telehealth_status")
}

model TelehealthSession {
  id                 String            @id @default(uuid())
  bookingId          String
  clinicId           String
  physicianId        String
  patientToken       String
  scheduledAt        DateTime
  status             TelehealthStatus  @default(scheduled)
  startedAt          DateTime?
  endedAt            DateTime?
  durationSeconds    Int?
  videoProvider      String            @default("livekit")
  providerRoomId     String
  patientJoinToken   String?
  physicianJoinToken String?
  tokensIssuedAt     DateTime?
  intakeSubmitted    Boolean           @default(false)
  hisSynced          Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  intake   TelehealthIntake?
  summary  TelehealthSummary?

  @@index([bookingId])
  @@index([clinicId])
  @@index([physicianId])
  @@index([status])
  @@index([scheduledAt])
  @@map("telehealth_sessions")
}

model TelehealthIntake {
  id                  String            @id @default(uuid())
  sessionId           String            @unique
  session             TelehealthSession @relation(fields: [sessionId], references: [id])
  reason              String
  currentMedications  String
  symptoms            String
  vitalsNote          String?
  submittedAt         DateTime

  @@map("telehealth_intake")
}

model TelehealthSummary {
  id                      String            @id @default(uuid())
  sessionId               String            @unique
  session                 TelehealthSession @relation(fields: [sessionId], references: [id])
  clinicalNote            String
  followUpRecommendationSk String?
  followUpRecommendationEn String?
  prescriptionIssued      Boolean           @default(false)
  prescriptionRef         String?
  pdfPath                 String?
  hisEncounterId          String?
  createdAt               DateTime          @default(now())

  @@map("telehealth_summaries")
}

// ─── Wearables & Remote Monitoring ────────────────────────────────────────────
// No patient identity stored — opaque patientToken only (eID-derived).
// OAuth tokens are AES-256-GCM encrypted at the application layer.

enum WearablePlatform {
  abbott_libre
  dexcom
  medtronic_cgm
  medtronic_cardiac
  abbott_cardiac
  boston_scientific
  alivecor
  withings
  omron
  apple_health
  google_health
  samsung_health
  fitbit
  garmin
  huawei
  xiaomi
  meta

  @@map("wearable_platforms")
}

enum WearableCategory {
  medical
  consumer

  @@map("wearable_category")
}

enum WearableDeviceType {
  cgm
  pacemaker
  ecg
  bp
  smartwatch
  fitness
  hybrid
  other

  @@map("device_type")
}

enum WearableSyncStatus {
  ok
  error
  pending
  revoked

  @@map("wearable_sync_status")
}

enum ReadingFlag {
  normal
  high
  low
  critical
  info

  @@map("reading_flag")
}

model WearableDevice {
  id                   String              @id @default(uuid()) @db.Uuid
  patientToken         String              @map("patient_token")
  platform             WearablePlatform
  deviceLabel          String              @map("device_label")
  category             WearableCategory
  deviceType           WearableDeviceType  @map("device_type")
  oauthAccessTokenEnc  String?             @map("oauth_access_token_enc")
  oauthRefreshTokenEnc String?             @map("oauth_refresh_token_enc")
  oauthExpiresAt       DateTime?           @map("oauth_expires_at") @db.Timestamptz
  shareWithPhysician   Boolean             @default(true) @map("share_with_physician")
  lastSyncAt           DateTime?           @map("last_sync_at") @db.Timestamptz
  syncStatus           WearableSyncStatus  @default(pending) @map("sync_status")
  syncError            String?             @map("sync_error")
  partnershipRequired  Boolean             @default(false) @map("partnership_required")
  connectedAt          DateTime            @default(now()) @map("connected_at") @db.Timestamptz
  disconnectedAt       DateTime?           @map("disconnected_at") @db.Timestamptz
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  readings   DeviceReading[]
  consents   DeviceConsent[]
  syncJobs   DeviceSyncJob[]

  @@index([patientToken])
  @@index([platform])
  @@index([syncStatus])
  @@map("wearable_devices")
}

model DeviceReading {
  id                String         @id @default(uuid()) @db.Uuid
  deviceId          String         @map("device_id") @db.Uuid
  device            WearableDevice @relation(fields: [deviceId], references: [id])
  patientToken      String         @map("patient_token")
  metricType        String         @map("metric_type")
  metricLabel       Json           @map("metric_label")
  valueNumeric      Decimal?       @map("value_numeric") @db.Decimal(12, 4)
  valueText         String?        @map("value_text")
  unit              String         @default("")
  flag              ReadingFlag    @default(normal)
  recordedAt        DateTime       @map("recorded_at") @db.Timestamptz
  receivedAt        DateTime       @default(now()) @map("received_at") @db.Timestamptz
  fhirObservationId String?        @map("fhir_observation_id")
  supersededBy      String?        @map("superseded_by") @db.Uuid
  supersededByRef   DeviceReading? @relation("ReadingSupersession", fields: [supersededBy], references: [id])
  supersedes        DeviceReading[] @relation("ReadingSupersession")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz

  @@index([deviceId, recordedAt(sort: Desc)], map: "idx_dr_device_recorded")
  @@index([patientToken, recordedAt(sort: Desc)], map: "idx_dr_patient_recorded")
  @@map("device_readings")
}

model DeviceConsent {
  id           String         @id @default(uuid()) @db.Uuid
  patientToken String         @map("patient_token")
  deviceId     String         @map("device_id") @db.Uuid
  device       WearableDevice @relation(fields: [deviceId], references: [id])
  consentType  String         @map("consent_type") // 'data_storage' | 'physician_sharing' | 'his_export'
  granted      Boolean
  grantedAt    DateTime       @default(now()) @map("granted_at") @db.Timestamptz
  withdrawnAt  DateTime?      @map("withdrawn_at") @db.Timestamptz
  ipHash       String         @map("ip_hash")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz

  @@index([patientToken])
  @@index([deviceId])
  @@map("device_consent")
}

model DeviceAlertThreshold {
  id                    String   @id @default(uuid()) @db.Uuid
  patientToken          String   @map("patient_token")
  metricType            String   @map("metric_type")
  thresholdHigh         Decimal? @map("threshold_high") @db.Decimal(12, 4)
  thresholdLow          Decimal? @map("threshold_low") @db.Decimal(12, 4)
  thresholdCriticalHigh Decimal? @map("threshold_critical_high") @db.Decimal(12, 4)
  thresholdCriticalLow  Decimal? @map("threshold_critical_low") @db.Decimal(12, 4)
  setByPhysicianId      String   @map("set_by_physician_id") // opaque physician id (TEXT)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([patientToken, metricType])
  @@map("device_alert_thresholds")
}

model DeviceSyncJob {
  id              String         @id @default(uuid()) @db.Uuid
  deviceId        String         @map("device_id") @db.Uuid
  device          WearableDevice @relation(fields: [deviceId], references: [id])
  status          String         // 'pending'|'running'|'completed'|'failed'
  startedAt       DateTime?      @map("started_at") @db.Timestamptz
  completedAt     DateTime?      @map("completed_at") @db.Timestamptz
  readingsFetched Int            @default(0) @map("readings_fetched")
  error           String?
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz

  @@index([deviceId])
  @@index([status])
  @@map("device_sync_jobs")
}

// ─── Payment receipts ────────────────────────────────────────────────────────

model PaymentReceipt {
  id             String   @id @default(uuid())
  transactionRef String   @unique
  bookingId      String?
  pdfContent     Bytes?              // inline PDF bytes; generated on payment.completed webhook
  createdAt      DateTime @default(now())

  @@index([bookingId])
  @@map("payment_receipts")
}
