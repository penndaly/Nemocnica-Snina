{
  "kind": "collectionType",
  "collectionName": "news_items",
  "info": {
    "singularName": "news-item",
    "pluralName": "news-items",
    "displayName": "News / Announcement"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginsOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "date": {
      "type": "date",
      "required": true
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "good",
        "info",
        "alert"
      ],
      "required": true,
      "default": "info"
    },
    "tag": {
      "type": "string",
      "required": true,
      "pluginsOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "title": {
      "type": "string",
      "required": true,
      "pluginsOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "body": {
      "type": "richtext",
      "required": true,
      "pluginsOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "review_status": {
      "type": "enumeration",
      "enum": [
        "needs_review",
        "approved",
        "rejected"
      ],
      "default": "needs_review",
      "pluginsOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "reviewed_by": {
      "type": "string",
      "pluginsOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "reviewed_at": {
      "type": "datetime",
      "pluginsOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "review_notes": {
      "type": "text",
      "pluginsOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
