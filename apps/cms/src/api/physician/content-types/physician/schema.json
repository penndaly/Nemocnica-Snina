{
  "kind": "collectionType",
  "collectionName": "physicians",
  "info": {
    "singularName": "physician",
    "pluralName": "physicians",
    "displayName": "Physician"
  },
  "options": { "draftAndPublish": true },
  "pluginsOptions": { "i18n": { "localized": true } },
  "attributes": {
    "name":      { "type": "string",  "required": true },
    "slug":      { "type": "uid",     "targetField": "name" },
    "role":      { "type": "string",  "required": true, "pluginsOptions": { "i18n": { "localized": true } } },
    "bio":       { "type": "text",    "pluginsOptions": { "i18n": { "localized": true } } },
    "accepting": { "type": "boolean", "required": true, "default": false },
    "langs":     { "type": "json",    "description": "Array of language codes, e.g. [\"SK\",\"EN\"]" },
    "department": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::department.department",
      "inversedBy": "physicians"
    },
    "clinic": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::clinic.clinic",
      "inversedBy": "physicians"
    },
    "facility": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::facility.facility",
      "inversedBy": "physicians"
    },
    "avatar": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "telehealth": {
      "type": "boolean",
      "required": true,
      "default": false,
      "description": "Physician participates in telehealth video consultations"
    }
  }
}
