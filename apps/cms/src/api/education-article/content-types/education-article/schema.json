{
  "kind": "collectionType",
  "collectionName": "education_articles",
  "info": {
    "singularName": "education-article",
    "pluralName": "education-articles",
    "displayName": "Education article",
    "description": "Patient education library — clinical content, from DATA_MODEL.md educationLibrary"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginsOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginsOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "predoperacne",
        "chronicke",
        "materska",
        "dieta",
        "fyziatria"
      ],
      "required": true
    },
    "excerpt": {
      "type": "text",
      "required": true,
      "pluginsOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "body": {
      "type": "richtext",
      "pluginsOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "readingMinutes": {
      "type": "integer"
    },
    "review_status": {
      "type": "enumeration",
      "enum": [
        "needs_review",
        "approved",
        "rejected"
      ],
      "default": "needs_review",
      "pluginsOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "reviewed_by": {
      "type": "string",
      "pluginsOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "reviewed_at": {
      "type": "datetime",
      "pluginsOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "review_notes": {
      "type": "text",
      "pluginsOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
