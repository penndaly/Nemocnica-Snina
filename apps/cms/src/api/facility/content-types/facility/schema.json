{
  "kind": "collectionType",
  "collectionName": "facilities",
  "info": {
    "singularName": "facility",
    "pluralName": "facilities",
    "displayName": "Facility (SVaLZ)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "lead": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "desc": {
      "type": "text",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "features": {
      "type": "json",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "physicians": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::physician.physician",
      "mappedBy": "facility"
    },
    "review_status": {
      "type": "enumeration",
      "enum": [
        "needs_review",
        "approved",
        "rejected"
      ],
      "default": "needs_review",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "reviewed_by": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "reviewed_at": {
      "type": "datetime",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "review_notes": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
