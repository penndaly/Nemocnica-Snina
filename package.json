{
  "name": "nemocnica-snina",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": { "node": ">=22", "pnpm": ">=9" },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,md}\"",
    "test": "turbo run test",
    "db:push": "turbo run db:push --filter=@ns/api",
    "db:seed": "turbo run db:seed --filter=@ns/api"
  },
  "workspaces": ["apps/*", "packages/*"],
  "devDependencies": {
    "turbo": "^2.3.3",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "overrides": {
      "better-sqlite3": "^11.0.0"
    }
  }
}
